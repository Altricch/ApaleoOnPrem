  "definitions": {
    "CreateTaxDefinitionModel": {
      "type": "object",
      "required": [
        "applicability",
        "calculationRules",
        "classification",
        "code",
        "description",
        "name",
        "propertyId",
        "vatHandlingType",
        "vatType"
      ],
      "properties": {
        "code": {
          "type": "string",
          "description": "The code of the tax definition."
        },
        "propertyId": {
          "type": "string",
          "description": "The id of the property this tax definition belongs to."
        },
        "name": {
          "type": "object",
          "description": "The name of the tax definition, as displayed to guests on folio, invoice, etc.",
          "additionalProperties": {
            "type": "string"
          }
        },
        "description": {
          "type": "object",
          "description": "The description of the tax definition.",
          "additionalProperties": {
            "type": "string"
          }
        },
        "classification": {
          "type": "string",
          "description": "The classification of the tax definition. Immutable after creation.",
          "enum": [
            "LocalTax",
            "ConsumptionTax"
          ]
        },
        "vatType": {
          "type": "string",
          "description": "The VAT type that applies to this tax definition. Set to \u0027Without\u0027 if no VAT applies.",
          "enum": [
            "Null",
            "VeryReduced",
            "Reduced",
            "Normal",
            "Without",
            "Special",
            "Special1",
            "Special2",
            "ReducedCovid19",
            "NormalCovid19",
            "Mixed"
          ]
        },
        "vatHandlingType": {
          "type": "string",
          "description": "Whether VAT is included in or excluded from calculated tax amount.",
          "enum": [
            "Excluded",
            "Included"
          ]
        },
        "applicability": {
          "$ref": "#/definitions/TaxApplicabilityModel"
        },
        "calculationRules": {
          "type": "array",
          "description": "Rules that define how the tax amount is calculated.\nOnly one rule is considered for calculation based on the priority and filters.",
          "items": {
            "$ref": "#/definitions/TaxCalculationRuleModel"
          }
        }
      },
      "additionalProperties": false,
      "example": {
        "code": "ALCOHOL",
        "propertyId": "MUC",
        "name": {
          "en": "Alcohol tax"
        },
        "description": {
          "en": "Alcohol tax description"
        },
        "classification": "ConsumptionTax",
        "vatType": "Reduced",
        "vatHandlingType": "Included",
        "applicability": {
          "appliedTo": {
            "services": [
              {
                "serviceType": "FoodAndBeverages",
                "subAccountIds": [
                  "ALCOHOL"
                ]
              }
            ]
          }
        },
        "calculationRules": [
          {
            "validityPeriod": {
              "from": "2025-06-01",
              "to": "2025-08-31"
            },
            "stayDayIndexRange": {
              "from": 0,
              "to": 10
            },
            "priority": 10,
            "calculationKind": "Percent",
            "calculationBase": "Gross",
            "calculation": {
              "type": "PerService",
              "perService": {
                "value": 7.5
              }
            }
          }
        ]
      }
    },
    "DayIndexRangeModel": {
      "type": "object",
      "required": [
        "from"
      ],
      "properties": {
        "from": {
          "type": "integer",
          "description": "The zero-based start day index of the stay. For example, 0 means the first night.",
          "format": "int32",
          "maximum": 2147483647,
          "minimum": 0
        },
        "to": {
          "type": "integer",
          "description": "The zero-based end day index of the stay (inclusive). If not set, the rule applies from \u0027From\u0027 onwards.",
          "format": "int32",
          "maximum": 2147483647,
          "minimum": 0,
          "x-nullable": true
        }
      },
      "additionalProperties": false
    },
    "MessageItemCollection": {
      "type": "object",
      "properties": {
        "messages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "readOnly": true,
          "x-nullable": true
        }
      },
      "additionalProperties": false
    },
    "Operation": {
      "type": "object",
      "properties": {
        "value": {
          "x-nullable": true
        },
        "path": {
          "type": "string",
          "x-nullable": true
        },
        "op": {
          "type": "string",
          "x-nullable": true
        },
        "from": {
          "type": "string",
          "x-nullable": true
        }
      },
      "additionalProperties": false
    },
    "PerServiceTaxCalculationModel": {
      "type": "object",
      "required": [
        "value"
      ],
      "properties": {
        "value": {
          "type": "number",
          "description": "The value of tax applied once per service (e.g. percentage or fixed amount depending on CalculationKind).",
          "format": "double"
        }
      },
      "additionalProperties": false
    },
    "TaxApplicabilityModel": {
      "type": "object",
      "required": [
        "appliedTo"
      ],
      "properties": {
        "appliedTo": {
          "$ref": "#/definitions/TaxApplicabilityScopeModel"
        }
      },
      "additionalProperties": false
    },
    "TaxApplicabilityScopeModel": {
      "type": "object",
      "required": [
        "services"
      ],
      "properties": {
        "services": {
          "type": "array",
          "description": "The list of service filters that determine which services this tax applies to.",
          "items": {
            "$ref": "#/definitions/TaxableServiceFilterModel"
          }
        }
      },
      "additionalProperties": false
    },
    "TaxCalculationModel": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "description": "The type of calculation.",
          "enum": [
            "PerService"
          ]
        },
        "perService": {
          "$ref": "#/definitions/PerServiceTaxCalculationModel"
        }
      },
      "additionalProperties": false
    },
    "TaxCalculationRuleModel": {
      "type": "object",
      "required": [
        "calculation",
        "calculationBase",
        "calculationKind",
        "priority"
      ],
      "properties": {
        "validityPeriod": {
          "$ref": "#/definitions/ValidityPeriodModel"
        },
        "stayDayIndexRange": {
          "$ref": "#/definitions/DayIndexRangeModel"
        },
        "priority": {
          "type": "integer",
          "description": "The priority of this rule.\nIn case of multiple rules match the conditions, the rule with the highest value of priority is considered.",
          "format": "int32"
        },
        "calculationKind": {
          "type": "string",
          "description": "The kind of calculation.",
          "enum": [
            "Percent",
            "FixedAmount"
          ]
        },
        "calculationBase": {
          "type": "string",
          "description": "The tax base used for calculation.",
          "enum": [
            "Net",
            "Gross"
          ]
        },
        "calculation": {
          "$ref": "#/definitions/TaxCalculationModel"
        }
      },
      "additionalProperties": false
    },
    "TaxDefinitionCreatedModel": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "The id of the created tax definition."
        }
      },
      "additionalProperties": false
    },
    "TaxDefinitionListItemModel": {
      "type": "object",
      "required": [
        "classification",
        "code",
        "description",
        "id",
        "name",
        "propertyId",
        "vatHandlingType",
        "vatType"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "The id of the tax definition."
        },
        "code": {
          "type": "string",
          "description": "The code of the tax definition."
        },
        "propertyId": {
          "type": "string",
          "description": "The id of the property this tax definition belongs to."
        },
        "name": {
          "type": "string",
          "description": "The name of the tax definition, as displayed to guests on folio, invoice, etc.",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "description": "The description of the tax definition.",
          "minLength": 1
        },
        "classification": {
          "type": "string",
          "description": "The classification of the tax definition.",
          "enum": [
            "LocalTax",
            "ConsumptionTax"
          ]
        },
        "vatType": {
          "type": "string",
          "description": "The VAT type that applies to this tax definition. Set to \u0027Without\u0027 if no VAT applies.",
          "enum": [
            "Null",
            "VeryReduced",
            "Reduced",
            "Normal",
            "Without",
            "Special",
            "Special1",
            "Special2",
            "ReducedCovid19",
            "NormalCovid19",
            "Mixed"
          ]
        },
        "vatHandlingType": {
          "type": "string",
          "description": "Whether VAT is included in or excluded from calculated tax amount.",
          "enum": [
            "Excluded",
            "Included"
          ]
        }
      },
      "additionalProperties": false
    },
    "TaxDefinitionListModel": {
      "type": "object",
      "required": [
        "count",
        "taxDefinitions"
      ],
      "properties": {
        "taxDefinitions": {
          "type": "array",
          "description": "List of tax definitions",
          "items": {
            "$ref": "#/definitions/TaxDefinitionListItemModel"
          }
        },
        "count": {
          "type": "integer",
          "description": "Total count of items",
          "format": "int64"
        }
      },
      "additionalProperties": false,
      "example": {
        "taxDefinitions": [
          {
            "id": "MUC-ALCOHOL",
            "code": "ALCOHOL",
            "propertyId": "MUC",
            "name": "Alcohol tax",
            "description": "Tax on alcoholic beverages",
            "classification": "ConsumptionTax",
            "vatType": "Reduced",
            "vatHandlingType": "Included"
          }
        ],
        "count": 1
      }
    },
    "TaxDefinitionModel": {
      "type": "object",
      "required": [
        "applicability",
        "calculationRules",
        "classification",
        "code",
        "description",
        "id",
        "name",
        "propertyId",
        "vatHandlingType",
        "vatType"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "The id of the tax definition."
        },
        "code": {
          "type": "string",
          "description": "The code of the tax definition."
        },
        "propertyId": {
          "type": "string",
          "description": "The id of the property this tax definition belongs to."
        },
        "name": {
          "type": "object",
          "description": "The name of the tax definition, as displayed to guests on folio, invoice, etc.",
          "additionalProperties": {
            "type": "string"
          }
        },
        "description": {
          "type": "object",
          "description": "The description of the tax definition.",
          "additionalProperties": {
            "type": "string"
          }
        },
        "classification": {
          "type": "string",
          "description": "The classification of the tax definition.",
          "enum": [
            "LocalTax",
            "ConsumptionTax"
          ]
        },
        "vatType": {
          "type": "string",
          "description": "The VAT type that applies to this tax definition. Set to \u0027Without\u0027 if no VAT applies.",
          "enum": [
            "Null",
            "VeryReduced",
            "Reduced",
            "Normal",
            "Without",
            "Special",
            "Special1",
            "Special2",
            "ReducedCovid19",
            "NormalCovid19",
            "Mixed"
          ]
        },
        "vatHandlingType": {
          "type": "string",
          "description": "Whether VAT is included in or excluded from calculated tax amount.",
          "enum": [
            "Excluded",
            "Included"
          ]
        },
        "applicability": {
          "$ref": "#/definitions/TaxApplicabilityModel"
        },
        "calculationRules": {
          "type": "array",
          "description": "Rules that define how the tax amount is calculated.\nOnly one rule is considered for calculation based on the priority and filters.",
          "items": {
            "$ref": "#/definitions/TaxCalculationRuleModel"
          }
        }
      },
      "additionalProperties": false,
      "example": {
        "id": "MUC-ALCOHOL",
        "code": "ALCOHOL",
        "propertyId": "MUC",
        "name": {
          "en": "Alcohol tax"
        },
        "description": {
          "en": "Alcohol tax description"
        },
        "classification": "ConsumptionTax",
        "vatType": "Reduced",
        "vatHandlingType": "Included",
        "applicability": {
          "appliedTo": {
            "services": [
              {
                "serviceType": "FoodAndBeverages",
                "subAccountIds": [
                  "ALCOHOL"
                ]
              }
            ]
          }
        },
        "calculationRules": [
          {
            "validityPeriod": {
              "from": "2025-06-01",
              "to": "2025-08-31"
            },
            "stayDayIndexRange": {
              "from": 0,
              "to": 10
            },
            "priority": 10,
            "calculationKind": "Percent",
            "calculationBase": "Gross",
            "calculation": {
              "type": "PerService",
              "perService": {
                "value": 7.5
              }
            }
          }
        ]
      }
    },
    "TaxableServiceFilterModel": {
      "type": "object",
      "required": [
        "serviceType"
      ],
      "properties": {
        "serviceType": {
          "type": "string",
          "description": "The type of service this filter applies to.",
          "enum": [
            "Other",
            "Accommodation",
            "FoodAndBeverages",
            "CancellationFees",
            "NoShow"
          ]
        },
        "subAccountIds": {
          "type": "array",
          "description": "The sub-account ids this filter is restricted to. A missing or null\nlist means the filter applies regardless of the service\u0027s sub-account\n(equivalent to an empty list).",
          "items": {
            "type": "string"
          },
          "x-nullable": true
        }
      },
      "additionalProperties": false
    },
    "ValidityPeriodModel": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string",
          "description": "The start date of the validity period. If not set, the rule is valid from the beginning of time.",
          "format": "date",
          "example": "2020-10-10",
          "x-nullable": true
        },
        "to": {
          "type": "string",
          "description": "The end date of the validity period. If not set, the rule is valid indefinitely.",
          "format": "date",
          "example": "2020-10-10",
          "x-nullable": true
        }
      },
      "additionalProperties": false
    }
  },
  "securityDefinitions": {
