      "patch": {
        "tags": [
          "TaxDefinition"
        ],
        "summary": "Patch a tax definition.",
        "description": "Patch a specific tax definition by its id using JSON Patch.\nHere is the list of operations that are currently allowed:\n- Replace name\n- Replace description\n- Replace vatType\n- Replace vatHandlingType\n- Replace applicability\n- Replace, add, or remove calculationRules\u003Cbr\u003EYou must have this scope: \u0027admin\u0027.",
        "operationId": "TaxesTax-definitionsByIdPatch",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "description": "The id of the tax definition.",
            "required": true,
            "type": "string"
          },
          {
            "in": "body",
            "name": "body",
            "description": "The JSON Patch operations to apply.",
            "required": true,
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Operation"
              }
            }
          }
        ],
        "responses": {
