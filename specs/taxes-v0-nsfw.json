        ],
        "summary": "Delete a tax definition.",
        "description": "Hard delete a specific tax definition by its id.\u003Cbr\u003EYou must have this scope: \u0027admin\u0027.",
        "operationId": "TaxesTax-definitionsByIdDelete",
